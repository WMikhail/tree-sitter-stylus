{
  "grammars": [
    {
      "name": "stylus",
      "camelcase": "Stylus",
      "scope": "source.stylus",
      "path": ".",
      "file-types": [
        "styl",
        "stylus"
      ],
      "highlights": "queries/highlights.scm",
      "tags": "queries/tags.scm",
      "injection-regex": "^styl(us)?$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Stylus stylesheet language.",
    "authors": [
      {
        "name": "WMikhail"
      }
    ]
  },
  "bindings": {
    "c": true,
    "node": true,
    "rust": true
  }
}
